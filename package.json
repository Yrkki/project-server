{
  "name": "project-server",
  "version": "2.0.0",
  "description": "CV Generator Project Server",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "echo npx --yes snyk test",
    "snyk-protect": "echo npx --yes snyk-protect",
    "prepare": "npm run snyk-protect",
    "setup": "npm-run-all setup:*",
    "setup:install": "npm install --legacy-peer-deps --ignore-scripts",
    "setup:rebuild": "npm rebuild",
    "update-packages": "npm-run-all update-packages:*",
    "update-packages:install": "npm run setup",
    "update-packages:npm-outdated": "npm outdated",
    "off:update-packages:npm-update-save": "npm update",
    "update-packages:npx-npm-check-updates-u": "npx --yes npm-check-updates --timeout 600000 -u --packageFile package.json && npm run update-packages:install"
  },
  "keywords": [
    "CV Generator",
    "ProjectServer"
  ],
  "author": "jorich",
  "license": "Apache-2.0",
  "dependencies": {
    "@snyk/protect": "^1.1307.0",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "debug": "~4.4.3",
    "express": "~5.2.1",
    "http-errors": "^2.0.1",
    "mime-types": "^3.0.2",
    "morgan": "~1.12.0",
    "ms": "^2.1.3",
    "nconf": "^0.13.0",
    "npm-run-all": "^4.1.5",
    "pug": "^3.0.4",
    "serve-favicon": "^2.5.1",
    "spdy": "^4.0.2",
    "url-exist": "^3.0.1"
  },
  "snyk": true
}
